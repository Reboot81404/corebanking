# Core Banking Application Environment Configuration Template
# Gercek degerleri repoya eklemeyiniz. Bu dosya yalnizca sablondur;
# Spring Boot .env dosyasini kendiliginden yuklemez. Degerleri shell/IDE/container ortaminda tanimlayin.

DB_URL=jdbc:postgresql://localhost:5432/corebanking_prod
DB_USERNAME=postgres
DB_PASSWORD=
BANK_CODE=00000

# Generate a unique random value of at least 32 UTF-8 bytes; never commit the real secret.
JWT_SECRET=<generate-a-random-secret-of-at-least-32-bytes>
JWT_ISSUER=corebanking-prod
JWT_EXPIRATION_MS=900000

# OpenAPI is disabled by default. Set both to true only in approved environments.
OPENAPI_ENABLED=false
OPENAPI_PUBLIC=false

# One-time first-admin bootstrap. Keep disabled by default; unset all three after the first admin is created.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Process-local login throttling; also configure gateway rate limits in clustered deployments.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_TRACKED_CLIENTS=10000
